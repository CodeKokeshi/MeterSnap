<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MeterSnap" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Edge-to-edge: Make system bars transparent/translucent -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- Light status bar icons when in light mode -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.MeterSnap" parent="Base.Theme.MeterSnap" />
    
    <!-- Dark theme for camera screens -->
    <style name="Theme.MeterSnap.Camera" parent="Base.Theme.MeterSnap">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>