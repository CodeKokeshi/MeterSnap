<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MeterSnap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ms_blue_primary</item>
        <item name="colorOnPrimary">@color/ms_blue_on_primary</item>
        <item name="colorPrimaryContainer">@color/ms_blue_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ms_blue_on_primary_container</item>
        <item name="colorSecondary">@color/ms_blue_secondary</item>
        <item name="colorOnSecondary">@color/ms_blue_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ms_blue_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ms_blue_on_secondary_container</item>
        <item name="colorTertiary">@color/ms_blue_tertiary</item>
        <item name="colorOnTertiary">@color/ms_blue_on_tertiary</item>
        <item name="android:colorBackground">@color/app_screen_background</item>
        <item name="cardViewStyle">@style/Widget.MeterSnap.CardView</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Widget.MeterSnap.CardView" parent="CardView">
        <item name="cardBackgroundColor">@color/app_card_background</item>
    </style>

    <style name="Theme.MeterSnap" parent="Base.Theme.MeterSnap" />

    <style name="Theme.MeterSnap.Camera" parent="Base.Theme.MeterSnap">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>