<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        android:elevation="4dp"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Settings"
        app:titleTextColor="?android:attr/textColorPrimary"
        app:titleMarginStart="8dp" />

    <!-- Navigation Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- History and Readings Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_history_readings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="History and Readings"
            android:textSize="16sp"
            android:padding="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:icon="@drawable/ic_history"
            app:iconGravity="start"
            app:iconPadding="12dp"/>

        <!-- Rate Configuration Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rate_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rate Configuration"
            android:textSize="16sp"
            android:padding="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:icon="@drawable/ic_rates"
            app:iconGravity="start"
            app:iconPadding="12dp"/>

        <!-- Other Options Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_other_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Other Options"
            android:textSize="16sp"
            android:padding="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:icon="@drawable/ic_more_options"
            app:iconGravity="start"
            app:iconPadding="12dp"/>

    </LinearLayout>

</LinearLayout>

