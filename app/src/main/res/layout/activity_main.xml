<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_camera_root_background"
    tools:context=".MainActivity">

    <!-- Full-screen camera preview container -->
    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_camera_preview_fallback" />

    <!-- Square 1:1 guidebox â€” always visible on the live camera feed.
         Elevation 6dp: above camera (0dp) but hidden by captured preview (7dp).
         The user should fit the entire meter display inside this box. -->
    <com.kokeshi.metersnap.MeterGuideBoxView
        android:id="@+id/meter_guide_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/captured_preview_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="7dp">

        <ImageView
            android:id="@+id/captured_preview_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Captured preview"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/snap_loading_spinner"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 5:1 digit guide overlay â€” 5 equal 1:1 squares side by side.
         Fills the camera area between top bar and bottom bar.
         Each square guides the user to align one meter digit. -->
    <!-- Debug buttons - above overlay -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="60dp"
        android:layout_marginStart="8dp"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btn_debug_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Debug Strip"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minHeight="0dp"
            android:clickable="false"/>

        <Button
            android:id="@+id/btn_debug_fake_prev_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Fake Prev"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minHeight="0dp"
            android:layout_marginTop="4dp"
            android:clickable="false"/>
    </LinearLayout>

    <!-- Instruction text â€” shown above the preview area -->
    <TextView
        android:id="@+id/tv_instructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make sure the meter numbers are visible, then press Snap"
        android:textColor="@color/main_camera_instruction_default"
        android:textSize="15sp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintVertical_bias="0.20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Live reading result â€” shown below the preview area -->
    <TextView
        android:id="@+id/tv_live_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:text=""
        android:textColor="@color/main_camera_live_result"
        android:textSize="24sp"
        android:textStyle="bold"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintVertical_bias="0.62"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Top bar: app name + help button -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/main_camera_chrome_background"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/main_camera_chrome_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="4dp" />

        <ImageButton
            android:id="@+id/btn_help"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_icon_button"
            android:contentDescription="Guide"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_help"
            app:tint="@color/main_camera_chrome_content" />
    </LinearLayout>

    <!-- Bottom bar: Settings | Snap | Manual Input -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="406dp"
        android:layout_height="132dp"
        android:background="@color/main_camera_chrome_background"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Settings"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/main_camera_chrome_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Settings"
                android:textColor="@color/main_camera_chrome_content"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <!-- Snap button: captures the live frame and runs per-digit OCR -->
            <ImageButton
                android:id="@+id/btn_snap"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Snap"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_snap"
                android:visibility="visible"
                app:tint="@color/main_camera_chrome_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Snap"
                android:textColor="@color/main_camera_chrome_content"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageButton
                android:id="@+id/btn_manual_input"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Manual Input"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_manual_input"
                app:tint="@color/main_camera_chrome_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manual Input"
                android:textColor="@color/main_camera_chrome_content"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Torch button (kept for torch toggle, hidden by default) -->
    <ImageButton
        android:id="@+id/btn_torch"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="Toggle Flashlight"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_flashlight_off"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Scan line kept in tree (hidden) so existing references don't crash -->
    <View
        android:id="@+id/scan_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Invisible gesture overlay: tap-to-focus, swipe-zoom, swipe-exposure -->
    <View
        android:id="@+id/gesture_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:elevation="5dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Zoom slider HUD â€” visible during horizontal swipe, fades out after -->
    <FrameLayout
        android:id="@+id/zoom_slider_container"
        android:layout_width="200dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_slider_container"
        android:elevation="9dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/zoom_toggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dim track showing full zoom range -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_slider_track" />

        <!-- Bright fill growing from the left -->
        <View
            android:id="@+id/zoom_slider_fill"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_slider_fill" />

        <!-- Current zoom ratio label -->
        <TextView
            android:id="@+id/zoom_slider_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:text="1.0Ã—"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Brightness slider HUD â€” visible during vertical swipe, fades out after -->
    <FrameLayout
        android:id="@+id/brightness_slider_container"
        android:layout_width="36dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_slider_container"
        android:elevation="9dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- Dim track showing full brightness range -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_slider_track" />

        <!-- Bright fill growing from the bottom -->
        <View
            android:id="@+id/brightness_slider_fill"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_slider_fill" />

    </FrameLayout>

    <!-- Zoom toggle pill â€” sits above the Snap button -->
    <LinearLayout
        android:id="@+id/zoom_toggle"
        android:layout_width="84dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_zoom_toggle"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_load_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/zoom_1x"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:text="1x"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_zoom_active" />

        <TextView
            android:id="@+id/zoom_2x"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2x"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@android:color/transparent" />

    </LinearLayout>

    <!-- Load Image button â€” sits between zoom toggle and snap, lets user pick a gallery photo -->
    <ImageButton
        android:id="@+id/btn_load_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_circle_icon_button"
        android:contentDescription="Load Image"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_load_image"
        android:elevation="8dp"
        app:tint="@color/main_camera_chrome_content"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
