<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <com.kokeshi.metersnap.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp"/>
    
    <!-- Debug buttons - above overlay -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="60dp"
        android:layout_marginStart="8dp"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        
        <Button
            android:id="@+id/btn_debug_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:text="Debug Strip"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minHeight="0dp"/>
        
        <Button
            android:id="@+id/btn_debug_fake_prev_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:text="Fake Prev"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minHeight="0dp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <View
        android:id="@+id/guide_box"
        android:layout_width="300dp"
        android:layout_height="150dp"
        android:background="@drawable/guide_box_border_enhanced"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <View
        android:id="@+id/scan_line"
        android:layout_width="300dp"
        android:layout_height="4dp"
        android:background="@drawable/scan_line"
        app:layout_constraintBottom_toBottomOf="@+id/guide_box"
        app:layout_constraintEnd_toEndOf="@+id/guide_box"
        app:layout_constraintStart_toStartOf="@+id/guide_box"
        app:layout_constraintTop_toTopOf="@+id/guide_box" />

    <TextView
        android:id="@+id/tv_instructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Point camera at your water meter\nMake sure the numbers are readable"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_box"
        app:layout_constraintEnd_toEndOf="@+id/guide_box"
        app:layout_constraintStart_toStartOf="@+id/guide_box" />

    <TextView
        android:id="@+id/tv_live_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:text=""
        android:textColor="#00FF00"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/guide_box"
        app:layout_constraintBottom_toTopOf="@+id/btn_torch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:elevation="10dp"/>

    <ImageButton
        android:id="@+id/btn_help"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="Help"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_snap"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Load Image"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_load_image"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btn_torch"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:background="@android:color/transparent"
        android:contentDescription="Toggle Flashlight"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_flashlight_off"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btn_snap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="56dp"
        android:layout_marginStart="24dp"
        android:background="@android:color/transparent"
        android:contentDescription="Settings"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btn_manual_input"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="56dp"
        android:layout_marginEnd="24dp"
        android:background="@android:color/transparent"
        android:contentDescription="Manual Input"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_configuration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>