<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_camera_root_background"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_camera_preview_fallback" />

    <com.kokeshi.metersnap.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp"/>
    
    <!-- Debug buttons - above overlay -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="60dp"
        android:layout_marginStart="8dp"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        
        <Button
            android:id="@+id/btn_debug_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Debug Strip"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minHeight="0dp"
            android:clickable="false"/>
        
        <Button
            android:id="@+id/btn_debug_fake_prev_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Fake Prev"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minHeight="0dp"
            android:layout_marginTop="4dp"
            android:clickable="false"/>
    </LinearLayout>

    <View
        android:id="@+id/guide_box"
        android:layout_width="300dp"
        android:layout_height="150dp"
        android:background="@drawable/guide_box_border_enhanced"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <View
        android:id="@+id/scan_line"
        android:layout_width="300dp"
        android:layout_height="4dp"
        android:background="@drawable/scan_line"
        app:layout_constraintBottom_toBottomOf="@+id/guide_box"
        app:layout_constraintEnd_toEndOf="@+id/guide_box"
        app:layout_constraintStart_toStartOf="@+id/guide_box"
        app:layout_constraintTop_toTopOf="@+id/guide_box" />

    <TextView
        android:id="@+id/tv_instructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Point camera at your water meter\nMake sure the numbers are readable"
        android:textColor="@color/main_camera_instruction_default"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        app:layout_constraintBottom_toTopOf="@+id/guide_box"
        app:layout_constraintEnd_toEndOf="@+id/guide_box"
        app:layout_constraintStart_toStartOf="@+id/guide_box" />

    <TextView
        android:id="@+id/tv_live_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:text=""
        android:textColor="@color/main_camera_live_result"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/guide_box"
        app:layout_constraintBottom_toTopOf="@+id/tv_mlkit_live"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:elevation="10dp"/>

    <TextView
        android:id="@+id/tv_mlkit_live"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:text=""
        android:textColor="#FFA726"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_paddle_live"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_live_result" />

    <TextView
        android:id="@+id/tv_paddle_live"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:text=""
        android:textColor="#42A5F5"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_ocr_debug"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_mlkit_live" />

    <TextView
        android:id="@+id/tv_ocr_debug"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:maxLines="3"
        android:paddingHorizontal="8dp"
        android:text=""
        android:textColor="#FF5252"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_torch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_paddle_live" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/main_camera_chrome_background"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/main_camera_chrome_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="4dp" />

        <ImageButton
            android:id="@+id/btn_help"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_icon_button"
            android:contentDescription="Guide"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_help"
                app:tint="@color/main_camera_chrome_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="406dp"
        android:layout_height="132dp"
        android:background="@color/main_camera_chrome_background"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Settings"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/main_camera_chrome_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Settings"
                android:textColor="@color/main_camera_chrome_content"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageButton
                android:id="@+id/btn_snap"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Load Image"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_load_image"
                android:visibility="visible"
                app:tint="@color/main_camera_chrome_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Load Image"
                android:textColor="@color/main_camera_chrome_content"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageButton
                android:id="@+id/btn_manual_input"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Manual Input"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_manual_input"
                app:tint="@color/main_camera_chrome_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manual Input"
                android:textColor="@color/main_camera_chrome_content"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_torch"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="Toggle Flashlight"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_flashlight_off"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/paused_capture_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        android:elevation="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_paused_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:visibility="gone" />

        <com.kokeshi.metersnap.CropSelectionView
            android:id="@+id/crop_selection_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_crop_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="16dp"
            android:background="#66000000"
            android:gravity="center"
            android:padding="10dp"
            android:text="Drag to draw your own crop box over digits."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_resume_capture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="96dp"
            android:text="Resume"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>