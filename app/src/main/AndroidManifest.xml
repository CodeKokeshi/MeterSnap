<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MeterSnapApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeterSnap">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.MeterSnap" />
        <activity
            android:name=".ManualInputActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.MeterSnap"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".BillResultActivity"
            android:exported="false"
            android:parentActivityName=".ManualInputActivity"
            android:theme="@style/Theme.MeterSnap" />
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:parentActivityName=".HistorySettingsActivity"
            android:theme="@style/Theme.MeterSnap" />

        <activity
            android:name=".SessionLogsActivity"
            android:exported="false"
            android:parentActivityName=".HistorySettingsActivity"
            android:theme="@style/Theme.MeterSnap" />
        
        <activity
            android:name=".HistorySettingsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.MeterSnap" />
        
        <activity
            android:name=".RateConfigurationActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.MeterSnap" />
        
        <activity
            android:name=".OtherOptionsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.MeterSnap" />

        <activity
            android:name=".ScannerTuningActivity"
            android:exported="false"
            android:parentActivityName=".OtherOptionsActivity"
            android:theme="@style/Theme.MeterSnap" />
        
        <activity
            android:name=".BillComparisonActivity"
            android:exported="false"
            android:parentActivityName=".ManualInputActivity"
            android:theme="@style/Theme.MeterSnap" />

        <activity
            android:name=".ProjectionBreakdownActivity"
            android:exported="false"
            android:parentActivityName=".HistorySettingsActivity"
            android:theme="@style/Theme.MeterSnap" />
        
        <!-- End-of-month reminder broadcast receiver -->
        <receiver
            android:name=".notifications.EndOfMonthReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kokeshi.metersnap.ACTION_REMIND_SCAN" />
                <action android:name="com.kokeshi.metersnap.ACTION_LAST_DAY_REMINDER" />
            </intent-filter>
        </receiver>
        
        <!-- Periodic scan reminder broadcast receiver -->
        <receiver
            android:name=".notifications.PeriodicScanReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kokeshi.metersnap.ACTION_PERIODIC_SCAN_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Boot completed receiver to reschedule alarms -->
        <receiver
            android:name=".notifications.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>